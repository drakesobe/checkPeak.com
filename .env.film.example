# CheckPeak Film Intelligence — add these to your .env.local
# Copy the values after running infrastructure/film-pipeline.sh

# ── AWS credentials (create a dedicated IAM user with least-privilege policy) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── S3 buckets (output from film-pipeline.sh) ──────────────────────────────────
FILM_S3_BUCKET=checkpeak-film-raw-prod
FILM_CLIPS_BUCKET=checkpeak-film-clips-prod

# ── SQS queue URL (output from film-pipeline.sh) ───────────────────────────────
FILM_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/checkpeak-film-processing-prod
