# CheckPeak Film Intelligence — add these to your .env.local
# Values from your AWS account (793001767322, us-east-1)

# ── AWS credentials ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── S3 buckets ─────────────────────────────────────────────────────────────────
FILM_S3_BUCKET=checkpeak-film-raw-prod
FILM_CLIPS_BUCKET=checkpeak-film-clips-prod

# ── SQS queue — wakes the ECS worker after upload ──────────────────────────────
# Find in AWS Console → SQS → checkpeak-film-processing-prod → copy Queue URL
FILM_SQS_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/checkpeak-film-processing-prod

# ── Mux (video delivery) ───────────────────────────────────────────────────────
# Used for streaming plays in the tape room if the worker pushes to Mux
MUX_TOKEN_ID=xxxxxxxxxxxxxxxxxxxxxxxx
MUX_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
